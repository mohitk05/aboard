{
  "name": "aboard",
  "version": "2.0.0",
  "private": true,
  "description": "A slow, real-time train travel world",
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite web",
    "build": "npm run build:web && npm run typecheck && npm test",
    "build:web": "vite build web",
    "deploy": "npm run build:web && wrangler deploy",
    "test": "vitest run && vitest run --config web/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "cf-typegen": "wrangler types",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "hono": "^4.13.16",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
